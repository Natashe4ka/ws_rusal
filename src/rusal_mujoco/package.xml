  <version>0.1.0</version>
  <description>MuJoCo contact dynamics for robotic ingot handling and palletizing</description>
  <maintainer email="safonova.nk@gmail.com">rusal-sim maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
